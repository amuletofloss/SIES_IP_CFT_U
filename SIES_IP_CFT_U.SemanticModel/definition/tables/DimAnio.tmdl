/// Dimensión para filtrar y describir DimAnio.
table DimAnio
	lineageTag: 06b70c84-0ef7-45ca-adf4-4bf9cfd2b2df

	column Año
		dataType: int64
		lineageTag: 424abcba-a5e0-4235-99b2-904e27b705b3
		summarizeBy: none
		sourceColumn: Anio

	partition Source = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(pCarpetaDatos & "\\dim_anio.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {
					{"Anio", Int64.Type}
					}, "es-CL")
				in
					Typed

